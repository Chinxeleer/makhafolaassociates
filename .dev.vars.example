# Copy to .dev.vars for local development (pnpm preview). Never commit .dev.vars.
# Production values are set with: pnpm wrangler secret put <NAME>

# Resend API key. Use "dry-run" locally to skip sending (logs only that a message would be sent).
RESEND_API_KEY=dry-run

# Turnstile secret. This is Cloudflare's "always passes" test secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Where enquiries are delivered. Defaults to the firm email in src/data/site.ts if empty.
CONTACT_TO_EMAIL=meshack@makhafola-associates.co.za

---
// Road Accident Fund guide. All copy comes from src/data/raf.ts and src/data/practice-areas.ts.
import { faArrowLeft, faCheck, faPlus } from "@fortawesome/free-solid-svg-icons";
import Button from "../../components/Button.astro";
import ContactBand from "../../components/ContactBand.astro";
import Container from "../../components/Container.astro";
import Icon from "../../components/Icon.astro";
import Section from "../../components/Section.astro";
import Steps from "../../components/Steps.astro";
import {
  claimCovers,
  rafArea,
  rafFaq,
  rafSeo,
  rafSteps,
  timeLimits,
  whatToBring,
  whoCanClaim,
} from "../../data/raf";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

const area = rafArea;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: rafFaq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout title={rafSeo.title} description={rafSeo.description} namespace="practice-raf" jsonLd={jsonLd}>
  {/* <!-- TODO: attorney to review RAF and estates copy before launch --> */}

  <Container class="pt-36 pb-16 md:pt-44 md:pb-24">
    <a href="/practice-areas/" class="link inline-flex min-h-11 items-center gap-2 text-small">
      <Icon icon={faArrowLeft} class="size-3.5" />
      All practice areas
    </a>
    <h1 data-reveal-heading class="mt-8 max-w-4xl font-heading text-h1 font-semibold">
      Road Accident Fund claims
    </h1>
    <p class="mt-8 max-w-prose text-body">{area.summary}</p>
    <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
      <Button href={`/contact/?area=${area.slug}`}>Book a consultation</Button>
      <Button href={site.whatsapp.href} variant="secondary" target="_blank" rel="noopener">
        {site.whatsapp.label}
      </Button>
    </div>
  </Container>

  {/* 1. Who can claim: large ruled rows */}
  <Section surface="surface-2" labelledby="who-heading">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-8">
      <h2 id="who-heading" class="font-heading text-h2 font-semibold lg:col-span-4">
        Who can claim
      </h2>
      <ul data-stagger-list class="border-t border-rule lg:col-span-7 lg:col-start-6">
        {whoCanClaim.map((item) => (
          <li class="border-b border-rule py-5 font-heading text-h3 font-medium text-pretty">{item}</li>
        ))}
      </ul>
    </div>
  </Section>

  {/* 2. What a claim can cover: title and explanation side by side */}
  <Section labelledby="covers-heading">
    <div class="max-w-3xl">
      <h2 id="covers-heading" class="font-heading text-h2 font-semibold">
        What a claim can cover
      </h2>
      <p class="mt-4 max-w-prose text-ink-muted">What can be claimed depends on the facts of each claim.</p>
    </div>
    <dl data-stagger-list class="mt-12 border-t border-rule">
      {claimCovers.map((item) => (
        <div class="grid grid-cols-1 gap-1 border-b border-rule py-6 md:grid-cols-12 md:gap-8">
          <dt class="font-heading text-h3 font-semibold md:col-span-4">{item.title}</dt>
          <dd class="text-ink-muted md:col-span-7 md:col-start-6">{item.body}</dd>
        </div>
      ))}
    </dl>
  </Section>

  {/* 3. How we handle a claim: a real sequence, so numbered */}
  <Section surface="surface-2" labelledby="process-heading">
    <h2 id="process-heading" class="mb-12 font-heading text-h2 font-semibold md:mb-16">
      How we handle a claim
    </h2>
    <Steps steps={rafSteps} />
  </Section>

  {/* 4. What to bring: a checklist */}
  <Section labelledby="bring-heading">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <h2 id="bring-heading" class="font-heading text-h2 font-semibold">
          What to bring to your first consultation
        </h2>
        <p class="mt-4 max-w-prose text-ink-muted">Bring what you have. We can help you obtain the rest.</p>
      </div>
      <ul data-stagger-list class="flex flex-col gap-4 lg:col-span-6 lg:col-start-7">
        {whatToBring.map((item) => (
          <li class="flex items-start gap-4 text-h3">
            <Icon icon={faCheck} class="mt-1.5 size-4 text-gold-700" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  {/* 5. Time limits: neutral wording. Numbers render only once an attorney has verified them. */}
  <Section surface="surface-2" labelledby="limits-heading">
    <div class="grid grid-cols-1 gap-8 border-y border-rule py-10 lg:grid-cols-12 lg:gap-8">
      <h2 id="limits-heading" class="font-heading text-h2 font-semibold lg:col-span-4">
        Time limits matter
      </h2>
      <div class="lg:col-span-7 lg:col-start-6">
        {timeLimits.verified ? (
          <>
            <ul class="flex flex-col gap-3">
              {timeLimits.items.map((item) => (
                <li class="max-w-prose">{item}</li>
              ))}
            </ul>
            <p class="mt-6 max-w-prose text-ink-muted">
              We confirm the deadline that applies to your claim at the first consultation.
            </p>
          </>
        ) : (
          <p class="max-w-prose">{timeLimits.fallback}</p>
        )}
      </div>
    </div>
  </Section>

  {/* 6. FAQ: native details/summary, also published as FAQPage structured data */}
  <Section labelledby="faq-heading">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-8">
      <h2 id="faq-heading" class="font-heading text-h2 font-semibold lg:col-span-4">
        Questions about RAF claims
      </h2>
      <div class="border-t border-rule lg:col-span-8 lg:col-start-5">
        {rafFaq.map((item) => (
          <details data-accordion class="group border-b border-rule">
            <summary class="flex min-h-11 cursor-pointer items-start justify-between gap-6 py-5 font-heading text-h3 font-semibold">
              <span>{item.question}</span>
              <Icon
                icon={faPlus}
                class="mt-1.5 size-4 shrink-0 text-gold-700 transition-transform duration-(--dur-fast) ease-out-quart group-open:rotate-45"
              />
            </summary>
            <div data-accordion-panel>
              <p class="max-w-prose pb-6 text-ink-muted">{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </Section>

  <ContactBand />
</BaseLayout>

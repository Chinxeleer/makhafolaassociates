---
import { faWhatsapp } from "@fortawesome/free-brands-svg-icons";
import {
  faClock,
  faEnvelope,
  faLocationDot,
  faMapLocationDot,
  faPhone,
} from "@fortawesome/free-solid-svg-icons";
import Icon from "../components/Icon.astro";
import ContactForm from "../components/ContactForm.astro";
import Container from "../components/Container.astro";
import EmailLink from "../components/EmailLink.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const { lat, lon } = site.geo;
const d = 0.004;
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${lon - d},${lat - d},${lon + d},${lat + d}&layer=mapnik&marker=${lat},${lon}`;
const mapLink = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=17/${lat}/${lon}`;
---

<BaseLayout
  title="Contact"
  description="Contact Makhafola & Associates Inc. at Tudor Chambers, Pretoria. Call 083 200 2036, message us on WhatsApp or send an enquiry."
  namespace="contact"
>
  <Container class="pt-36 pb-12 md:pt-44 md:pb-16">
    <h1 data-reveal-heading class="max-w-4xl font-heading text-h1 font-semibold">
      Contact
    </h1>
  </Container>

  <Container class="grid grid-cols-1 gap-16 pb-24 md:pb-32 lg:grid-cols-12 lg:gap-8">
    <div class="flex flex-col gap-10 lg:col-span-5">
      <dl class="flex flex-col border-t border-rule">
        <div class="grid grid-cols-1 gap-1 border-b border-rule py-5 sm:grid-cols-3 sm:gap-4">
          <dt class="flex items-center gap-2 text-small text-ink-muted">
            <Icon icon={faPhone} class="size-3.5 text-gold-700" />
            Phone
          </dt>
          <dd class="sm:col-span-2">
            <a href={site.phone.href} class="link -my-3 inline-flex min-h-11 items-center font-mono">
              {site.phone.display}
            </a>
          </dd>
        </div>
        <div class="grid grid-cols-1 gap-1 border-b border-rule py-5 sm:grid-cols-3 sm:gap-4">
          <dt class="flex items-center gap-2 text-small text-ink-muted">
            <Icon icon={faWhatsapp} class="size-3.5 text-gold-700" />
            WhatsApp
          </dt>
          <dd class="sm:col-span-2">
            <a
              href={site.whatsapp.href}
              target="_blank"
              rel="noopener"
              class="link -my-3 inline-flex min-h-11 items-center"
            >
              {site.whatsapp.label}
            </a>
          </dd>
        </div>
        <div class="grid grid-cols-1 gap-1 border-b border-rule py-5 sm:grid-cols-3 sm:gap-4">
          <dt class="flex items-center gap-2 text-small text-ink-muted">
            <Icon icon={faEnvelope} class="size-3.5 text-gold-700" />
            Email
          </dt>
          <dd class="sm:col-span-2">
            <EmailLink class="-my-3 inline-flex min-h-11 flex-wrap items-center" />
          </dd>
        </div>
        <div class="grid grid-cols-1 gap-1 border-b border-rule py-5 sm:grid-cols-3 sm:gap-4">
          <dt class="flex items-center gap-2 text-small text-ink-muted">
            <Icon icon={faLocationDot} class="size-3.5 text-gold-700" />
            Office
          </dt>
          <dd class="sm:col-span-2">
            <address class="not-italic">
              {site.address.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
            </address>
          </dd>
        </div>
        {/* TODO: office hours, set site.hours in src/data/site.ts */}
        {site.hours && (
          <div class="grid grid-cols-1 gap-1 border-b border-rule py-5 sm:grid-cols-3 sm:gap-4">
            <dt class="flex items-center gap-2 text-small text-ink-muted">
              <Icon icon={faClock} class="size-3.5 text-gold-700" />
              Office hours
            </dt>
            <dd class="sm:col-span-2">{site.hours}</dd>
          </div>
        )}
      </dl>

      <div>
        <div
          data-map-frame
          data-map-src={mapSrc}
          data-map-title={`Map showing ${site.address.street}, ${site.address.locality}`}
          class="relative aspect-4/3 w-full border border-rule bg-surface-2"
        >
          <div class="absolute inset-0 flex flex-col items-start justify-end gap-4 p-6">
            <p class="max-w-xs text-small text-ink-muted">
              The map loads from OpenStreetMap, which will receive your IP address.
            </p>
            <button
              type="button"
              data-map-load
              class="inline-flex min-h-11 items-center gap-2 border border-ink px-5 text-small font-medium transition-colors duration-(--dur-fast) ease-out-quart hover:bg-ink hover:text-surface"
            >
              <Icon icon={faMapLocationDot} class="size-4" />
              Show the map
            </button>
          </div>
        </div>
        <a
          href={mapLink}
          target="_blank"
          rel="noopener"
          class="link mt-3 inline-flex min-h-11 items-center text-small"
        >
          Open the location in OpenStreetMap
        </a>
      </div>
    </div>

    <div class="lg:col-span-6 lg:col-start-7">
      <ContactForm />
    </div>
  </Container>
</BaseLayout>

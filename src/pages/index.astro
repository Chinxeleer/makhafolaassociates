---
import Button from "../components/Button.astro";
import ContactBand from "../components/ContactBand.astro";
import Container from "../components/Container.astro";
// Hidden for now (see the Director and Insights sections below):
// import Director from "../components/Director.astro";
import HeroVideo from "../components/HeroVideo.astro";
// import InsightRow from "../components/InsightRow.astro";
import PracticeAreaGroups from "../components/PracticeAreaGroups.astro";
import Section from "../components/Section.astro";
import Steps from "../components/Steps.astro";
import { questionAnswers } from "../data/firm";
import { allAreaNames, speciality } from "../data/practice-areas";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
// import { getPublishedInsights } from "../lib/insights";

// const latest = (await getPublishedInsights()).slice(0, 3);
const [wide, ...narrow] = questionAnswers;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["LegalService", "Attorney"],
  "@id": `${site.url}/#firm`,
  name: site.name,
  description: site.tagline,
  url: site.url,
  telephone: site.phone.international,
  email: site.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  areaServed: site.areaServed,
  knowsAbout: allAreaNames,
  founder: { "@type": "Person", name: site.director, jobTitle: "Director" },
};
---

<BaseLayout
  title={site.name}
  description="Pretoria attorneys whose core practice is Road Accident Fund claims, led by an attorney with 25 years in technology and risk, also acting in family, estates, business, technology and dispute matters."
  namespace="home"
  heroDark
  jsonLd={jsonLd}
>
  {/* 1. Hero */}
  <section
    data-tone="dark"
    class="relative flex min-h-(--hero-min-h) flex-col bg-navy-800 text-on-dark"
    aria-labelledby="hero-heading"
  >
    <HeroVideo />
    <Container class="relative flex flex-1 flex-col justify-end pt-28 pb-12 md:pb-20">
      <div class="grid grid-cols-1 lg:grid-cols-12">
        <div class="font-hero lg:col-span-12">
          <h1 id="hero-heading" data-reveal-heading class="max-w-6xl text-hero font-bold">
            Legal counsel with an engineer's <em class="text-gold-300 not-italic">precision</em>.
          </h1>
          <p class="mt-6 max-w-xl text-body text-on-dark-muted md:mt-10">
            Pretoria attorneys whose core practice is Road Accident Fund claims, with family, estates,
            business and technology law alongside.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4 md:mt-10">
            <Button href={speciality.href} tone="dark">
              Start your RAF claim
            </Button>
            <Button href="/contact/" variant="secondary" tone="dark">
              Book a consultation
            </Button>
          </div>
        </div>
      </div>
    </Container>
  </section>

  {/* 2. Firm statement */}
  <Section size="statement" aria-label="About the firm">
    <div class="grid grid-cols-1 lg:grid-cols-12">
      <div class="lg:col-span-10 lg:col-start-2">
        <p data-read-aloud class="font-display text-h2 font-light text-ink">
          Founded by attorney and technologist Meshack Makhafola, Makhafola &amp; Associates brings a lawyer's
          judgement and an engineer's rigour to every matter, for individuals, startups and companies.
        </p>
        <a href="/about/" class="link mt-10 inline-flex min-h-11 items-center font-medium">
          Read about the firm
        </a>
      </div>
    </div>
  </Section>

  {/* 3. Core practice: Road Accident Fund claims. Navy, the firm's main offer; the light statement above and
       the grey areas below keep it from touching the navy hero or question section.
       <!-- TODO: attorney to review RAF and estates copy before launch --> */}
  <Section size="statement" surface="navy" labelledby="raf-home-heading">
    <div class="grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <h2 id="raf-home-heading" data-reveal-lines class="font-display text-h1 font-light">
          Road Accident Fund claims are the core of our practice.
        </h2>
        <p class="mt-8 max-w-prose text-on-dark-muted">
          Drivers, passengers, pedestrians and cyclists injured in road accidents, and the dependants of
          people killed in them, may be able to claim compensation from the Road Accident Fund. We handle the
          claim from lodgement to settlement or court.
        </p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
          <Button href={`/contact/?area=${speciality.slug}`} tone="dark">
            Start your RAF claim
          </Button>
          <Button href={speciality.href} variant="secondary" tone="dark">
            Read the guide to RAF claims
          </Button>
        </div>
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <h3 class="text-small font-medium text-on-dark-muted">What a claim can cover</h3>
        <ul data-stagger-list class="mt-4 border-t border-rule-dark">
          {speciality.claimCovers.map((item) => (
            <li class="border-b border-rule-dark py-4 font-heading text-h3 font-medium">{item.title}</li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  {/* 4. Other areas we act in (the core practice is above, not in this list) */}
  <Section surface="surface-2" labelledby="help-heading">
    <div class="mb-12 flex flex-col gap-6 md:mb-16 md:flex-row md:items-end md:justify-between">
      <h2 id="help-heading" class="font-heading text-h1 font-semibold">
        Other areas we act in
      </h2>
      <Button href="/practice-areas/" variant="secondary">
        See practice areas
      </Button>
    </div>
    <PracticeAreaGroups />
  </Section>

  {/* 5. Question */}
  <Section size="statement" surface="navy" labelledby="question-heading" data-question>
    <h2 id="question-heading" data-question-headline class="max-w-5xl font-heading text-h1 font-semibold">
      What do 25 years in technology mean for your legal matter?
    </h2>
    <div class="mt-16 grid grid-cols-1 gap-12 md:mt-24 lg:grid-cols-12 lg:gap-8">
      <div data-question-answer class="border-t border-rule-dark pt-6 lg:col-span-6">
        <h3 class="font-heading text-h2 font-semibold">{wide.title}</h3>
        <p class="mt-6 max-w-prose text-on-dark-muted">{wide.body}</p>
      </div>
      {narrow.map((a, i) => (
        <div
          data-question-answer
          class:list={[
            "border-t border-rule-dark pt-6 lg:col-span-3",
            i === 0 && "lg:col-start-7 lg:mt-24",
            i === 1 && "lg:mt-48",
          ]}
        >
          <h3 class="font-heading text-h3 font-semibold">{a.title}</h3>
          <p class="mt-4 text-small text-on-dark-muted">{a.body}</p>
        </div>
      ))}
    </div>
  </Section>

  {/* 6. Director: hidden until confirmed. To restore, uncomment this block and the Director import.
       It sits on the plain surface between the navy question section and the grey "How we work".
  <Section size="statement" aria-label="The director">
    <Director />
  </Section>
  */}

  {/* 7. How we work */}
  <Section surface="surface-2" labelledby="process-heading">
    <h2 id="process-heading" class="mb-12 font-heading text-h1 font-semibold md:mb-16">
      How we work
    </h2>
    <Steps />
    {site.portalUrl && (
      <a
        href={site.portalUrl}
        rel="noopener"
        class="link mt-12 inline-flex min-h-11 items-center font-medium"
      >
        Go to the client portal
      </a>
    )}
  </Section>

  {/* 8. Insights: hidden until confirmed. To restore, uncomment this block, the InsightRow and
       getPublishedInsights imports and the `latest` query in the frontmatter.
  <Section labelledby="insights-heading">
    <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <h2 id="insights-heading" class="font-heading text-h1 font-semibold">
        Insights
      </h2>
      <a href="/insights/" class="link inline-flex min-h-11 items-center font-medium">
        Read all insights
      </a>
    </div>
    <ul class="border-t border-rule">
      {latest.map((entry) => (
        <InsightRow entry={entry} />
      ))}
    </ul>
  </Section>
  */}

  {/* 9. Contact */}
  <ContactBand />
</BaseLayout>

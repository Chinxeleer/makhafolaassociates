---
import { credentials } from "../data/firm";
---

<p class="font-medium text-pretty text-ink">
  {credentials.map((item, i) => (
    <>
      <span class="whitespace-nowrap max-sm:whitespace-normal">{item}</span>
      {i < credentials.length - 1 && (
        <span aria-hidden="true" class="mx-3 text-gold-700">
          ·
        </span>
      )}
    </>
  ))}
</p>

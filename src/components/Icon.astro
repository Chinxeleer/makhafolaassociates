---
// Font Awesome icon rendered as inline SVG at build time (no Font Awesome CSS or JS ships to the browser).
// Use the Solid set (`@fortawesome/free-solid-svg-icons`) for the bold style, Brands for logos.
import type { IconDefinition } from "@fortawesome/free-solid-svg-icons";

interface Props {
  icon: IconDefinition;
  class?: string;
  /** Accessible name. Omit for decorative icons next to text (the default). */
  label?: string;
}

const { icon, class: className, label } = Astro.props;
const [width, height, , , path] = icon.icon;
const paths = Array.isArray(path) ? path : [path];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${width} ${height}`}
  fill="currentColor"
  class:list={["inline-block shrink-0", className ?? "size-4"]}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  {paths.map((d) => (
    <path d={d} />
  ))}
</svg>

---
import { faLocationDot, faPhone } from "@fortawesome/free-solid-svg-icons";
import Icon from "./Icon.astro";
import { Image } from "astro:assets";
import logoOnDark from "../assets/images/logo-on-dark.png";
import Container from "./Container.astro";
import EmailLink from "./EmailLink.astro";
import { nav, site } from "../data/site";

const year = new Date().getFullYear();
---

<footer data-tone="dark" class="bg-navy-900 text-on-dark">
  <Container class="grid grid-cols-1 gap-12 pt-20 pb-24 md:grid-cols-12 md:gap-8 lg:pt-24">
    <div class="md:col-span-4 md:flex md:items-center md:justify-center">
      <a href="/" class="inline-flex" aria-label={`${site.name}, home`}>
        <Image src={logoOnDark} alt="" layout="fixed" width={118} height={132} class="h-33 w-auto" />
      </a>
    </div>

    <address class="not-italic md:col-span-4">
      <h2 class="mb-4 text-small text-on-dark-muted">Visit</h2>
      <p class="flex gap-3 leading-relaxed">
        <Icon icon={faLocationDot} class="mt-1.5 size-4 text-gold-300" />
        <span>
          {site.address.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
        </span>
      </p>
      <ul class="mt-6 space-y-1">
        <li>
          <a href={site.phone.href} class="link inline-flex min-h-11 items-center gap-3 font-mono">
            <Icon icon={faPhone} class="size-4 text-gold-300" />
            {site.phone.display}
          </a>
        </li>
        <li>
          <EmailLink icon iconClass="size-4 text-gold-300" class="inline-flex min-h-11 items-center gap-3" />
        </li>
        <li>
          <EmailLink
            address={site.directorEmail}
            icon
            iconClass="size-4 text-gold-300"
            class="inline-flex min-h-11 items-center gap-3"
          />
        </li>
      </ul>
      {/* TODO: office hours, set site.hours in src/data/site.ts */}
      {site.hours && <p class="mt-4 text-on-dark-muted">{site.hours}</p>}
    </address>

    <nav aria-label="Footer" class="md:col-span-4">
      <h2 class="mb-4 text-small text-on-dark-muted">Pages</h2>
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} class="link inline-flex min-h-11 items-center">
              {item.label}
            </a>
          </li>
        ))}
        {site.portalUrl && (
          <li>
            <a href={site.portalUrl} class="link inline-flex min-h-11 items-center" rel="noopener">
              Client Portal
            </a>
          </li>
        )}
      </ul>
    </nav>
  </Container>

  <Container class="flex flex-col gap-4 border-t border-rule-dark pt-6 pb-24 text-meta text-on-dark-muted md:flex-row md:items-center md:justify-between md:pb-8">
    <p>{site.name} is a firm of attorneys practising in South Africa.</p>
    <ul class="flex flex-wrap items-center gap-x-6">
      <li>
        <a href="/privacy/" class="link inline-flex min-h-11 items-center">
          Privacy notice
        </a>
      </li>
      {site.paiaUrl && (
        <li>
          <a href={site.paiaUrl} class="link inline-flex min-h-11 items-center">
            PAIA manual
          </a>
        </li>
      )}
      <li>
        © {year} {site.shortName}
      </li>
    </ul>
  </Container>
</footer>

---
import { faWhatsapp } from "@fortawesome/free-brands-svg-icons";
import { faPhone } from "@fortawesome/free-solid-svg-icons";
import Icon from "./Icon.astro";
import { site } from "../data/site";
import Button from "./Button.astro";
import EmailLink from "./EmailLink.astro";
import GoldRule from "./GoldRule.astro";
import Section from "./Section.astro";
---

<Section size="band" surface="navy" labelledby="contact-band-heading">
  <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-7">
      <GoldRule class="mb-8" />
      <h2 id="contact-band-heading" class="font-heading text-h1 font-semibold">
        Tell us about your matter.
      </h2>
    </div>
    <div class="flex flex-col gap-8 lg:col-span-4 lg:col-start-9 lg:pt-12">
      <ul class="flex flex-col gap-1">
        <li>
          <a href={site.phone.href} class="link inline-flex min-h-11 items-center gap-3 font-mono">
            <Icon icon={faPhone} class="size-4 text-gold-300" />
            {site.phone.display}
          </a>
        </li>
        <li>
          <EmailLink icon iconClass="size-4 text-gold-300" class="inline-flex min-h-11 items-center gap-3" />
        </li>
        <li>
          <a
            href={site.whatsapp.href}
            target="_blank"
            rel="noopener"
            class="link inline-flex min-h-11 items-center gap-3"
          >
            <Icon icon={faWhatsapp} class="size-4 text-gold-300" />
            {site.whatsapp.label}
          </a>
        </li>
      </ul>
      <div>
        <Button href="/contact/" tone="dark">
          Book a consultation
        </Button>
      </div>
    </div>
  </div>
</Section>

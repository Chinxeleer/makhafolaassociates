---
import { faWhatsapp } from "@fortawesome/free-brands-svg-icons";
import { faPhone, faXmark } from "@fortawesome/free-solid-svg-icons";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import Container from "./Container.astro";
import { nav, site } from "../data/site";
---

<dialog
  id="mobile-menu"
  data-mobile-menu
  data-tone="dark"
  aria-label="Menu"
  class="m-0 h-dvh max-h-none w-full max-w-none bg-navy-800 p-0 text-on-dark"
>
  <div class="flex h-full flex-col">
    <Container class="flex h-(--header-h) shrink-0 items-center justify-between">
      <a href="/" class="flex min-h-11 items-center" data-menu-link aria-label={`${site.name}, home`}>
        <Logo tone="dark" />
      </a>
      <button
        type="button"
        data-menu-close
        class="-mr-3 inline-flex min-h-11 items-center gap-2 px-3 text-small font-medium"
      >
        <Icon icon={faXmark} class="size-4" />
        Close
      </button>
    </Container>

    <Container class="flex flex-1 flex-col justify-between gap-12 overflow-y-auto pt-10 pb-8">
      <nav aria-label="Mobile">
        <ul class="flex flex-col gap-2">
          <li data-menu-item>
            <a
              href="/"
              data-menu-link
              class="inline-flex min-h-11 items-center font-heading text-h1 font-medium"
            >
              Home
            </a>
          </li>
          {nav.map((item) => (
            <li data-menu-item>
              <a
                href={item.href}
                data-menu-link
                class="inline-flex min-h-11 items-center font-heading text-h1 font-medium"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex flex-col gap-1 border-t border-rule-dark pt-6" data-menu-item>
        <a href={site.phone.href} class="inline-flex min-h-11 items-center gap-3">
          <Icon icon={faPhone} class="size-4 text-gold-300" />
          <span class="sr-only">Call</span>
          <span class="font-mono">{site.phone.display}</span>
        </a>
        <a
          href={site.whatsapp.href}
          target="_blank"
          rel="noopener"
          class="link inline-flex min-h-11 items-center gap-3"
        >
          <Icon icon={faWhatsapp} class="size-4 text-gold-300" />
          {site.whatsapp.label}
        </a>
      </div>
    </Container>
  </div>
</dialog>

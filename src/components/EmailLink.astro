---
// Email link that may wrap only after the "@", never mid-word. `icon` adds the Font Awesome envelope.
// `address` defaults to the firm address (site.email).
import { faEnvelope } from "@fortawesome/free-solid-svg-icons";
import { site } from "../data/site";
import Icon from "./Icon.astro";

interface Props {
  address?: string;
  class?: string;
  icon?: boolean;
  iconClass?: string;
}
const { address = site.email, class: className, icon = false, iconClass = "size-4" } = Astro.props;
const [user, domain] = address.split("@");
---

<a href={`mailto:${address}`} class:list={["link", icon && "gap-2", className]}>
  {icon && <Icon icon={faEnvelope} class={iconClass} />}
  <span>
    {user}@<wbr />
    {domain}
  </span>
</a>
